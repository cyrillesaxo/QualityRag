# Copy to /etc/qualityrag/video-mcp.env (owned by root, mode 0640).
# This file contains NO production credentials.
QUALITYRAG_VIDEO_ROOT=/srv/qualityrag-video/media
QUALITYRAG_VIDEO_MCP_HOST=127.0.0.1
QUALITYRAG_VIDEO_MCP_PORT=8039
QUALITYRAG_VIDEO_MCP_ALLOWED_HOSTS=video-mcp.example.com
QUALITYRAG_VIDEO_MCP_ALLOWED_ORIGINS=
QUALITYRAG_VIDEO_MCP_ALLOWED_SOURCE_IDS=approved-video-001
QUALITYRAG_VIDEO_MCP_AUTH_MODE=jwt
QUALITYRAG_VIDEO_MCP_RESOURCE_URL=https://video-mcp.example.com/mcp
QUALITYRAG_VIDEO_MCP_AUDIENCE=https://video-mcp.example.com/mcp
QUALITYRAG_VIDEO_MCP_ISSUER=https://your-identity-provider.example
QUALITYRAG_VIDEO_MCP_JWKS_FILE=/etc/qualityrag/trusted-jwks.json
QUALITYRAG_VIDEO_MCP_ACL_FILE=/etc/qualityrag/video-access.json
