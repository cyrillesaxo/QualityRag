# Copy to /etc/systemd/system/qualityrag-governance.service.
# Service account has no shell and cannot modify checkout or signing keys.
[Unit]
Description=QualityRAG isolated signed-evidence governance HTTP API
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=qualityrag-governance
Group=qualityrag-governance
WorkingDirectory=/opt/qualityrag
Environment=PYTHONPATH=/opt/qualityrag
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/qualityrag/.venv/bin/python -m tools.activation_runtime.cli serve --root /var/lib/qualityrag-governance --keys /etc/qualityrag-governance/authority.json --port 8769
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=/var/lib/qualityrag-governance
SystemCallArchitectures=native
MemoryMax=1024M
TasksMax=70
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
