{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityrag.local/schemas/reviewed-activation/v1.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "qualityrag.reviewed-activation/v1"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_ir_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "action": {
      "enum": [
        "REQUIRES_REVIEW",
        "REFUSE",
        "FALLBACK"
      ]
    },
    "finite_constraint_result": {
      "enum": [
        "SAT",
        "UNSAT",
        "UNKNOWN"
      ]
    },
    "output": {
      "type": [
        "object",
        "null"
      ],
      "maxProperties": 128,
      "propertyNames": {
        "minLength": 1,
        "maxLength": 512
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean",
          "null"
        ]
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "action",
        "output",
        "trace",
        "can_generate"
      ],
      "properties": {
        "trace": {
          "type": "array",
          "maxItems": 5
        },
        "can_generate": {
          "const": false
        }
      }
    },
    "candidate_audit": {
      "type": "object"
    },
    "canonical_candidate": {
      "type": "object"
    },
    "compatibility": {
      "type": "object"
    },
    "preservation_review": {
      "type": "object"
    },
    "fallback_authority": {
      "enum": [
        "DISABLED",
        "SAME_SIGNED_SOURCE_AND_REVIEWED_CONTRACT"
      ]
    },
    "qualityrag_admission": {
      "const": "INCONCLUSIVE"
    },
    "can_generate": {
      "const": false
    },
    "evidence_boundary": {
      "type": "string"
    }
  },
  "required": [
    "schema",
    "tenant",
    "source_sha256",
    "artifact_sha256",
    "contract_sha256",
    "policy_ir_sha256",
    "action",
    "finite_constraint_result",
    "output",
    "execution",
    "candidate_audit",
    "canonical_candidate",
    "compatibility",
    "preservation_review",
    "fallback_authority",
    "qualityrag_admission",
    "can_generate",
    "evidence_boundary"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "REFUSE"
          }
        }
      },
      "then": {
        "properties": {
          "output": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "output": {
            "type": "object"
          },
          "finite_constraint_result": {
            "const": "SAT"
          }
        }
      }
    }
  ]
}
