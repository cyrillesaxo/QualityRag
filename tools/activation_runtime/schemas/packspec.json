{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityrag.local/schemas/packspec/v1.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "qualityrag.constraint-ir/v1"
    },
    "source": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "sha256"
      ]
    },
    "ir_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 240,
      "items": {
        "type": "object",
        "required": [
          "node_id",
          "kind",
          "parameters",
          "review",
          "source"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "EVIDENCE_PRESENCE",
              "TEMPORAL",
              "AUTHORITY",
              "PROBE",
              "PREDICATE"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object"
    }
  },
  "required": [
    "schema",
    "source",
    "ir_sha256",
    "nodes",
    "summary"
  ],
  "additionalProperties": true
}
