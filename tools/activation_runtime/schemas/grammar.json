{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qualityrag.local/schemas/grammar/v1.0",
  "type": "object",
  "properties": {
    "schema": {
      "const": "rct.typed-operator-grammar/v1.4"
    },
    "predicate_types": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 16,
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "operators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EDGE",
          "PATH",
          "AND"
        ]
      },
      "contains": {
        "const": "EDGE"
      }
    },
    "max_ast_nodes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    }
  },
  "required": [
    "schema",
    "predicate_types",
    "operators",
    "max_ast_nodes",
    "max_candidates"
  ],
  "additionalProperties": false
}
