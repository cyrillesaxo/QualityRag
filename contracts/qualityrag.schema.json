{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QualityRag input contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "pack",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "qualityrag.evaluate/v0.1"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "requirements"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "min_independent_sources": {
                "type": "integer",
                "minimum": 1
              },
              "max_age_seconds": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement_id",
          "origin",
          "source_ref",
          "status",
          "observed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SUPPORTS",
              "CONTRADICTS",
              "UNKNOWN"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    }
  }
}
